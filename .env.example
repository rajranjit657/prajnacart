# ==========================================
# PRAJNACART CONFIGURATION
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prajnacart
# Set DEMO_MODE=true if running without live PostgreSQL instance
DEMO_MODE=true

# Supabase Credentials (Optional for local demo mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# JWT Secret for authentication
JWT_SECRET=prajnacart_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test/Live Keys)
RAZORPAY_KEY_ID=rzp_test_PrajnacartDemoKey123
RAZORPAY_KEY_SECRET=rzp_secret_PrajnacartDemoSecret456
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_PrajnacartWebhookSecret789

# Default Admin Credentials for initial setup
ADMIN_EMAIL=admin@prajnacart.com
ADMIN_PASSWORD=Admin@123

# Email Service (SMTP or Resend/SendGrid)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=support@prajnacart.com
